# Impostazioni COMUNI a tutti gli account. Copia in .env (lo fa ./setup.sh) e compila.
# I segreti di ogni account (codice del bot Telegram, token Instagram) NON stanno qui:
# li scrive la procedura guidata in accounts/<nome>/account.env (permessi 600). Il vero .env non va mai nel repository.

# Servizio IA compatibile OpenAI (OmniRoute, un proxy qualsiasi, o un provider). Ogni account può avere una chiave propria.
OMNIROUTE_BASE_URL=https://ai.miodominio.it/v1
OMNIROUTE_API_KEY=
# Modelli: normale per la chat, ragionamento per piani e analisi, leggero per i lavori di fondo
MODEL_NORMAL=cc/claude-sonnet-5-5
MODEL_REASON=cc/claude-opus-5-5
MODEL_LIGHT=cc/claude-haiku-5-5

# Browser (lettura pagine web e grafici): internal = dentro questo contenitore, si accende solo quando serve (predefinito);
# external = servizio separato (BROWSER_URL e BROWSER_TOKEN); off = nessun browser.
BROWSER_MODE=internal

# Pannello web di configurazione: si accende solo se c'è una password (almeno 12 caratteri; la genera ./setup.sh).
# Raggiungibile solo da localhost: vedi docs/PANEL.md. Se lo metti dietro un proxy HTTPS, elenca qui il tuo dominio.
PANEL_PASSWORD=
PANEL_ALLOWED_HOSTS=localhost,127.0.0.1
PANEL_HOST_PORT=8787

# Utente che possiede ./data e ./accounts (lo imposta ./setup.sh)
MANAGER_UID=1000
MANAGER_GID=1000

HISTORY_MESSAGES=30
# Giorni dopo i quali i file ricevuti e non più usati vengono eliminati
MEDIA_RETENTION_DAYS=7
